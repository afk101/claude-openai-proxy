# ========================================
# OpenAI Responses Proxy 环境变量示例
# ========================================
# 复制为 .env 后按实际情况修改。修改 .env 后需要重启服务。

# Required: `/v1` 之前的 Responses 上游服务根地址。
# 代理会在该值后唯一追加 `/v1/responses`。
CLAUDE_BASE_URL="https://code.jizhi.360.cn/aiproxy"

# Optional: 普通回退密钥。
# 只有智企目录成功返回且目录中完全未出现请求模型时才使用。
# 优先级：CLAUDE_API_KEY > ANTHROPIC_API_KEY；按需配置一个即可。
# CLAUDE_API_KEY="your-ordinary-upstream-key"
# ANTHROPIC_API_KEY="your-compatible-upstream-key"

# Optional: 代理自身的访问密钥。
# 设置后，客户端必须提供同值 Bearer 或 x-api-key；留空表示不校验。
# PROXY_API_KEY="your-proxy-api-key"

# Optional: 服务监听地址与端口。
# HOST="0.0.0.0"
PORT="7072"

# Optional: 日志级别，可选 DEBUG、INFO、WARNING、ERROR、CRITICAL。
# LOG_LEVEL="INFO"

# Optional: 上游超时，单位为秒。
# REQUEST_TIMEOUT="90"
# READ_TIMEOUT="480"

# 智企套餐无需额外环境变量。代理读取 ~/.wiscode/auth.json 中的 host、
# access_token 和可选 mail 查询套餐；认证或目录失败时不会使用普通密钥绕过。
